APP_NAME="KKYF Membership Portal"
APP_URL=http://localhost/kkyf-tams
TIMEZONE=Africa/Lagos
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kkyf_portal_dev
DB_USER=root
DB_PASS=

# Mail: use log only for local development with APP_DEBUG=true.
# Production uses smtp with authenticated TLS.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="KKYF Membership Portal"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
